DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_AUDIT_CHANNEL_ID=
SERVER_NAME=Friend ARK

# Comma-separated Discord role IDs allowed to run destructive commands.
ARK_ADMIN_ROLE_IDS=

# ARK save-file rollback target. Ragnarok_WP is the active map folder observed in GPanel.
ARK_SAVE_DIR=/ShooterGame/Saved/SavedArks/Ragnarok_WP
ARK_MAP_NAME=Ragnarok_WP
ARK_RESTORE_SAFETY_PREFIX=discord-restore-safety

# provider values: mock, pterodactyl, rcon
SERVER_PROVIDER=mock

# Use these if the Legion Hosting customer panel exposes a Pterodactyl-compatible API.
PTERODACTYL_BASE_URL=
PTERODACTYL_API_KEY=
PTERODACTYL_SERVER_ID=
PTERODACTYL_STOP_BEFORE_RESTORE=true
PTERODACTYL_START_AFTER_RESTORE=true

# Use these if panel automation is unavailable but ARK RCON is exposed.
RCON_HOST=
RCON_PORT=27020
RCON_PASSWORD=
